# Notion Integration Secret (notion.so/my-integrations 에서 발급, 실제 값은 .env.local 에만 입력)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database IDs (notion.so URL에서 복사)
NOTION_MEMBERS_DB_ID=32자리ID
NOTION_PUBLICATIONS_DB_ID=32자리ID
NOTION_NEWS_DB_ID=32자리ID
NOTION_PROJECTS_DB_ID=32자리ID
